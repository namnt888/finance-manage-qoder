# Secrets — never commit
.env
.env.local
.env.*.local
*.pem
*.key

# Dependencies / build
node_modules/
dist/
.build/
*.tsbuildinfo
.pnpm-store/

# Generated artifacts (keep structure via .gitkeep)
batches/exports/*
!batches/exports/.gitkeep
batches/history/*
!batches/history/.gitkeep
runs/*
!runs/.gitkeep
reports/*.pdf

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Python scratch
__pycache__/
*.pyc
.venv/