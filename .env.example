# finance-manage-qoder — environment template (VAR NAMES ONLY, no secrets)
# Copy to .env.local and fill. .env.local is gitignored.

# --- Neon Postgres (append-only ledger + views) ---
NEON_DATABASE_URL=
NEON_DATABASE_URL_UNPOOLED=

# --- Migration source (READ-ONLY export from money-gemini Supabase) ---
# Do NOT put a production service_role key here. Use scoped export credentials.
SUPABASE_EXPORT_URL=
SUPABASE_EXPORT_ANON_KEY=

# --- Agent Submit API (kernel write path) ---
AGENT_SUBMIT_TOKEN=
KERNEL_BASE_URL=

# --- MCP server ---
MCP_SERVER_PORT=8787

# --- LLM (skill reasoning) ---
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Telegram channel (optional) ---
TELEGRAM_BOT_TOKEN=

# --- Google Sheets projection (GAS outbox) ---
GAS_DEPLOY_ID=
GAS_SCRIPT_ID=
SHEET_SYNC_SECRET=